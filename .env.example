# Ollama (local LLM) settings
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
OLLAMA_MODEL=qwen3:1.7b

# Telegram Bot settings
# Create a bot via @BotFather on Telegram to get a token.
TELEGRAM_BOT_TOKEN=
# Your personal chat id (see README for how to find it).
TELEGRAM_CHAT_ID=

# Storage
DATABASE_PATH=data/news.db

# Collection / editorial tuning
MAX_ARTICLES_PER_FEED=20
MAX_STORIES=10
# Cap on how many deduplicated candidate articles get sent to the local LLM
# per run (total, across all batches). Raise this if you're running a
# larger/faster model or have GPU acceleration.
MAX_CANDIDATE_ARTICLES=30
# The editor processes articles in small batches (merged + re-ranked after)
# rather than one giant prompt, since small/CPU-only models are unreliable
# or extremely slow on large batches. Raise this if you have a beefier setup.
EDITOR_BATCH_SIZE=5
# Hard cap on tokens the model may generate per call, so a struggling model
# can't loop forever without ever producing a stop token.
OLLAMA_MAX_OUTPUT_TOKENS=2048
# How long to wait (seconds) for a single batch's model response.
OLLAMA_TIMEOUT_SECONDS=600
